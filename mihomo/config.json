{
  "name": "Mihomo + Zashboard",
  "version": "1.19.34-7",
  "slug": "mihomo",
  "description": "HAOS 本机与容器透明代理，保留局域网访问和官方更新",
  "arch": ["amd64"],
  "url": "https://github.com/wsx68696/hassio-mihomo",
  "image": "ghcr.io/wsx68696/hassio-mihomo-{arch}",
  "startup": "system",
  "boot": "auto",
  "init": false,
  "host_network": true,
  "ports": {"9090/tcp": 9090},
  "ports_description": {"9090/tcp": "Zashboard 与受密钥保护的 Mihomo API"},
  "webui": "http://[HOST]:[PORT:9090]/ui/",
  "ingress": true,
  "ingress_port": 9091,
  "panel_icon": "mdi:network-outline",
  "panel_title": "Mihomo",
  "panel_admin": true,
  "privileged": ["NET_ADMIN", "NET_RAW"],
  "devices": ["/dev/net/tun"],
  "apparmor": true,
  "full_access": false,
  "hassio_api": false,
  "homeassistant_api": false,
  "docker_api": false,
  "host_pid": false,
  "host_dbus": false,
  "timeout": 60,
  "watchdog": "http://[HOST]:9090/ui/index.html",
  "options": {
    "subscription_url": "",
    "subscription_download": "auto",
    "subscription_interval": 3600,
    "subscription_debug": false,
    "update_download": "auto",
    "geodata_auto_update": false,
    "geodata_update_interval": 24,
    "controller_secret": "",
    "tun_enable": true,
    "dns_servers": ["https://dns.alidns.com/dns-query", "https://cloudflare-dns.com/dns-query"],
    "direct_domains": []
  },
  "schema": {
    "subscription_url": "str",
    "subscription_download": "list(auto|proxy|direct)",
    "subscription_interval": "int(60,86400)",
    "subscription_debug": "bool",
    "update_download": "list(auto|proxy|direct)",
    "geodata_download": "list(auto|proxy|direct)?",
    "geodata_auto_update": "bool",
    "geodata_update_interval": "int(1,720)",
    "controller_secret": "password",
    "tun_enable": "bool",
    "dns_servers": ["str"],
    "direct_domains": ["str"]
  }
}
